# ══════════════════════════════════════════════════════════════════════════
# P2P Solar Energy Trading — Firebase Configuration
# ══════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env    (Mac/Linux)
#                        copy .env.example .env   (Windows CMD)
#   2. Fill in YOUR values from Firebase (see guide below)
#   3. NEVER commit .env to GitHub — it is already in .gitignore ✅
#
# WHERE TO GET THE VALUES:
#   Firebase Console → https://console.firebase.google.com
#   → Your Project → Project Settings (⚙️ gear icon) → General tab
#   → Scroll to "Your apps" section → Web app (</>)  → Config
# ══════════════════════════════════════════════════════════════════════════

REACT_APP_FIREBASE_API_KEY=AIzaSy-REPLACE-WITH-YOUR-KEY
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789012
REACT_APP_FIREBASE_APP_ID=1:123456789012:web:abc123def456
